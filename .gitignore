.venv/

secrets/

# database — never commit or deploy the local SQLite file
db/fantasy.db
*.db

# Python bytecode
__pycache__/
*.pyc
*.pyo

# credential rotation output — contains a live DB password, never commit
rotate_db_password_output.txt

# Claude Code local permission settings - machine-specific, may contain credentials
.claude/settings.local.json

# DB snapshots - not source, already synced via OneDrive
backups/

# Loose planning docs at repo root — keep them local, never track.
# Root-anchored (leading slash): tools/ and any subfolder are unaffected.
/FantasyBeefs_*_Update_*.md
/OPUS_REVIEW_HANDOFF*.md

# Current plan/handoff docs — live only in the Claude project panel, never
# tracked here. Exact names, not globs, since future versioned files
# (v8, v49, etc.) should be a deliberate decision each time, not auto-caught.
/FantasyBeefs_MasterPlan_BAB_Reconciled_v7.md
/FantasyBeefs_New_Thread_Handoff_v48.md
/FantasyBeefs_v48_NextThread_Opener.md
/FantasyBeefs_MasterPlan_v8_LaunchPath.md
