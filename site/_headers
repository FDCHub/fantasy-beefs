# =============================================================================
# Cloudflare Pages response headers - fantasystakesapp.com
#
# This is a static marketing site with no backend, no form handler, no cookie
# and no third-party anything, so the policy below can be genuinely strict
# rather than strict-looking. Every directive was checked against the real page
# by tools/marketing/preview_check.mjs, which serves this exact file locally -
# a CSP that has only ever run in production is a CSP nobody has tested.
#
# THE SCRIPT HASH. `script-src 'self'` covers /js/config.js and /js/site.js. The
# one inline block on the site is the FAQPage JSON-LD in index.html, allowed by
# its sha256 hash rather than by 'unsafe-inline'. If that block is edited the
# hash must be regenerated; test_web1_marketing_site.py recomputes it and fails
# if the two have drifted, so this cannot rot silently.
#
# `connect-src 'none'` is deliberate and is the strongest single statement here:
# nothing on this site talks to anything, so any fetch, XHR, beacon or socket -
# including one that arrived by accident - is refused by the browser.
# =============================================================================

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; script-src 'self' 'sha256-arJypYd31/ejLQgmxPQlkFq1kIxgwQWyoCZ8pAao5fA='; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'none'; object-src 'none'; upgrade-insecure-requests

# Content-addressed by review rather than by filename hash, so the long cache is
# applied only to the two directories whose contents change together with a
# deliberate release rather than with a copy edit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# The demo destination lives in this file. A week of stale caching on it would
# be a week of readers sent to the old destination after the switch is thrown.
/js/config.js
  Cache-Control: public, max-age=300, must-revalidate
